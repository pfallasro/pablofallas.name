---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  heading: string;
  intro?: string;
  lastUpdated?: string;
}

const { title, description, heading, intro, lastUpdated } = Astro.props;
---

<Base title={title} description={description}>
  <Nav />
  <main id="main" class="pt-32 pb-24">
    <article class="max-w-[760px] mx-auto px-6 md:px-8">
      <header class="mb-12 pb-8 border-b" style="border-color: var(--color-rule);">
        <p
          class="text-[11px] uppercase tracking-[0.14em] mb-4"
          style="font-family: var(--font-mono); color: var(--color-red);"
        >
          Legal
        </p>
        <h1
          class="serif-display text-[clamp(40px,6vw,72px)] mb-4"
          style="color: var(--color-ink);"
        >
          {heading}
        </h1>
        {
          intro && (
            <p
              class="text-[17px] leading-[1.6] max-w-[560px]"
              style="color: var(--color-ink-soft);"
            >
              {intro}
            </p>
          )
        }
        {
          lastUpdated && (
            <p
              class="mt-6 text-[11px] uppercase tracking-[0.12em]"
              style="font-family: var(--font-mono); color: var(--color-ink-faint);"
            >
              Stand: {lastUpdated}
            </p>
          )
        }
      </header>
      <div class="legal-prose">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  .legal-prose {
    color: var(--color-ink-soft);
    font-size: 16px;
    line-height: 1.7;
  }
  .legal-prose h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .legal-prose h2:first-child {
    margin-top: 0;
  }
  .legal-prose h3 {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-faint);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose p {
    margin: 0 0 1.25rem;
  }
  .legal-prose ul {
    margin: 0 0 1.25rem 1.25rem;
    list-style: disc;
  }
  .legal-prose li {
    margin: 0.25rem 0;
  }
  .legal-prose a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-rule);
    transition: border-color 0.2s ease;
  }
  .legal-prose a:hover {
    border-color: var(--color-red);
    color: var(--color-red);
  }
  .legal-prose strong {
    color: var(--color-ink);
    font-weight: 500;
  }
  .legal-prose .placeholder {
    display: inline-block;
    padding: 0 0.4em;
    background: color-mix(in oklch, var(--color-red) 18%, transparent);
    border-radius: 3px;
    color: var(--color-ink);
    font-style: italic;
    font-size: 0.95em;
  }
</style>
