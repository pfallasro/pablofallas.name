---
const paragraphs = [
  {
    lead: true,
    text: "I build infrastructure, tooling and processes that let engineering teams ship reliably, securely and without the friction.",
  },
  {
    text: "Currently leading the Platform & Infrastructure team at Zenjob in Berlin. My day-to-day sits at the intersection of cloud, automation and developer experience: designing systems people genuinely enjoy working with, and helping a team of engineers grow into the work.",
  },
  {
    text: "I'm a people-first manager who still loves the craft. Most of my career has been about turning the messy operational reality of infrastructure into something predictable, observable, cost-aware and quietly excellent. Treating cloud spend as an engineering signal, not an invoice.",
  },
];
---

<section id="about" class="py-28 md:py-32">
  <div class="max-w-[1240px] mx-auto px-6 md:px-8">
    <header
      class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 items-baseline mb-14 pb-6 border-b"
      style="border-color: var(--color-rule);"
    >
      <div>
        <div class="eyebrow">
          <span style="color: var(--color-ink-faint); margin-right: 10px;">01</span>About
        </div>
        <h2 class="serif-display mt-4 text-[clamp(40px,5.5vw,72px)]">
          A little <em style="font-style: italic; color: var(--color-red);">about me</em>.
        </h2>
      </div>
      <p class="text-base leading-[1.6] max-w-[520px]" style="color: var(--color-ink-soft);">
        Software engineer turned platform leader. I care about the systems behind the systems: the
        boring infrastructure that lets product teams move fast without breaking sleep schedules.
      </p>
    </header>

    <div class="grid gap-12 md:gap-[72px] md:grid-cols-[1fr_1.4fr] items-start">
      <div class="relative">
        <div
          class="aspect-[3/4] rounded-[4px] border bg-cover bg-center"
          style="
            background-image:
              linear-gradient(180deg, rgba(10,31,74,.25), rgba(200,16,46,.18)),
              url('/pablo-profile.jpg');
            border-color: var(--color-rule);
          "
          role="img"
          aria-label="Portrait of Pablo Fallas"
        ></div>
        <div
          class="absolute -bottom-3.5 -right-3.5 w-20 h-20 rounded-[4px] -z-10"
          style="background: var(--color-red);"
        ></div>
      </div>

      <div>
        {
          paragraphs.map((p) =>
            p.lead ? (
              <p
                class="mb-7 text-[clamp(22px,2.4vw,30px)] leading-[1.35] text-pretty"
                style="font-family: var(--font-serif); color: var(--color-ink); letter-spacing: -0.005em;"
              >
                {p.text}
              </p>
            ) : (
              <p
                class="mb-7 text-[17px] leading-[1.6]"
                style="color: var(--color-ink-soft);"
              >
                {p.text}
              </p>
            ),
          )
        }
        <div
          class="mt-9 pt-6 flex items-center gap-3.5 border-t text-[12px] uppercase tracking-[0.12em]"
          style="border-color: var(--color-rule); font-family: var(--font-mono); color: var(--color-ink-faint);"
        >
          <span>Pablo Fallas Rodríguez</span>
          <span>·</span>
          <span
            class="normal-case"
            style="font-family: var(--font-serif); font-style: italic; font-size: 22px; color: var(--color-ink); letter-spacing: 0;"
          >
            Berlin, 2026
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
