---
const skills = [
  {
    idx: "001 / Cloud",
    title: "Cloud &",
    titleEm: "infrastructure",
    stack: ["AWS", "Terraform", "Kubernetes"],
    description:
      "Scalable cloud infrastructure built with infrastructure-as-code from day one. AWS Certified Developer Associate.",
  },
  {
    idx: "002 / FinOps",
    title: "Cost &",
    titleEm: "FinOps",
    stack: ["Cost Explorer", "Tagging", "Rightsizing", "Savings Plans"],
    description:
      "Cloud spend treated as an engineering signal. Attribution, rightsizing and continuous reviews that let teams ship fast without quietly burning the budget.",
  },
  {
    idx: "003 / CI/CD",
    title: "Automation &",
    titleEm: "delivery",
    stack: ["GitLab CI", "Ansible", "Docker", "Bash"],
    description:
      "Pipelines and developer tooling that turn \"deploys\" into the dullest moment of the day. Boring is the goal.",
  },
  {
    idx: "004 / Code",
    title: "Programming &",
    titleEm: "scripting",
    stack: ["Python", "Go", "Bash"],
    description:
      "Internal tools, automations and glue code that remove toil from teams. Written to be read, not admired.",
  },
  {
    idx: "005 / Observability",
    title: "Monitoring &",
    titleEm: "observability",
    stack: ["Grafana", "Prometheus", "Loki", "Datadog"],
    description:
      "Metrics, logs and alerts wired so the right person hears about the right thing at the right time, and almost never out of hours.",
  },
  {
    idx: "006 / Containers",
    title: "Container",
    titleEm: "orchestration",
    stack: ["Kubernetes", "Docker", "Helm"],
    description:
      "Running containerized workloads at scale. Clusters that survive Friday afternoons, holidays, and the occasional intern.",
  },
];
---

<section
  id="expertise"
  class="py-28 md:py-32 border-y"
  style="background: var(--color-paper-deep); border-color: var(--color-rule);"
>
  <div class="max-w-[1240px] mx-auto px-6 md:px-8">
    <header
      class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 items-baseline mb-14 pb-6 border-b"
      style="border-color: var(--color-rule);"
    >
      <div>
        <div class="eyebrow">
          <span style="color: var(--color-ink-faint); margin-right: 10px;">02</span>Expertise
        </div>
        <h2 class="serif-display mt-4 text-[clamp(40px,5.5vw,72px)]">
          What I do <em style="font-style: italic; color: var(--color-red);">well</em>.
        </h2>
      </div>
      <p class="text-base leading-[1.6] max-w-[520px]" style="color: var(--color-ink-soft);">
        Six disciplines I've sharpened over a decade of running production systems, from a single
        Costa Rican datacenter to multi-region platforms in Europe.
      </p>
    </header>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px border"
      style="background: var(--color-rule); border-color: var(--color-rule);"
    >
      {
        skills.map((s) => (
          <article
            class="p-8 md:p-9 flex flex-col gap-4 min-h-[240px] transition-colors"
            style="background: var(--color-paper-deep);"
            onmouseover="this.style.background='var(--color-paper-card)'"
            onmouseout="this.style.background='var(--color-paper-deep)'"
          >
            <div
              class="text-[11px] tracking-[0.12em]"
              style="font-family: var(--font-mono); color: var(--color-ink-faint);"
            >
              {s.idx}
            </div>
            <h3
              class="text-[30px] leading-[1.1] tracking-tight"
              style="font-family: var(--font-serif); font-weight: 400; color: var(--color-ink);"
            >
              {s.title}{" "}
              <em style="font-style: italic; color: var(--color-red);">{s.titleEm}</em>
            </h3>
            <div class="flex flex-wrap gap-1.5 mt-2">
              {s.stack.map((t) => (
                <span
                  class="text-[10.5px] px-2.5 py-1 rounded-[3px] tracking-[0.04em]"
                  style="font-family: var(--font-mono); background: color-mix(in oklch, var(--color-ink) 7%, transparent); color: var(--color-ink);"
                >
                  {t}
                </span>
              ))}
            </div>
            <p
              class="text-[14px] leading-[1.55] mt-auto"
              style="color: var(--color-ink-soft);"
            >
              {s.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
