---
const languages = [
  { name: "Spanish", level: "Native",        pct: 100 },
  { name: "English", level: "Proficient",    pct: 92 },
  { name: "German",  level: "A2 · learning", pct: 30 },
];
---

<section
  id="education"
  class="py-28 md:py-32 border-y"
  style="background: var(--color-paper-deep); border-color: var(--color-rule);"
>
  <div class="max-w-[1240px] mx-auto px-6 md:px-8">
    <header
      class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 items-baseline mb-14 pb-6 border-b"
      style="border-color: var(--color-rule);"
    >
      <div>
        <div class="eyebrow">
          <span style="color: var(--color-ink-faint); margin-right: 10px;">04</span>Education
        </div>
        <h2 class="serif-display mt-4 text-[clamp(40px,5.5vw,72px)]">
          Credentials & <em style="font-style: italic; color: var(--color-red);">languages</em>.
        </h2>
      </div>
      <p class="text-base leading-[1.6] max-w-[520px]" style="color: var(--color-ink-soft);">
        The receipts. Plus the languages I work in day to day. German is still a work in progress.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-3">
      <article
        class="p-8 rounded-[4px] border min-h-[280px] flex flex-col"
        style="background: var(--color-paper-card); border-color: var(--color-rule);"
      >
        <div
          class="mb-7 text-[11px] uppercase tracking-[0.14em]"
          style="font-family: var(--font-mono); color: var(--color-red);"
        >
          Education
        </div>
        <h3
          class="text-[26px] leading-[1.2] tracking-tight mb-3"
          style="font-family: var(--font-serif); font-weight: 400; color: var(--color-ink);"
        >
          Bachelor's in Software Development Engineering
        </h3>
        <div
          class="mt-auto pt-4.5 border-t text-[13px] leading-[1.6]"
          style="border-color: var(--color-rule); color: var(--color-ink-soft); padding-top: 18px;"
        >
          <span
            class="block mb-0.5 text-[10.5px] uppercase tracking-[0.12em]"
            style="font-family: var(--font-mono); color: var(--color-ink-faint);"
          >
            Institution
          </span>
          Cenfotec University<br />
          <span
            class="block mt-3.5 mb-0.5 text-[10.5px] uppercase tracking-[0.12em]"
            style="font-family: var(--font-mono); color: var(--color-ink-faint);"
          >
            Term
          </span>
          Apr 2010 – Dec 2016 · Costa Rica
        </div>
      </article>

      <article
        class="p-8 rounded-[4px] border min-h-[280px] flex flex-col"
        style="background: var(--color-paper-card); border-color: var(--color-rule);"
      >
        <div
          class="mb-7 text-[11px] uppercase tracking-[0.14em]"
          style="font-family: var(--font-mono); color: var(--color-red);"
        >
          Certification
        </div>
        <h3
          class="text-[26px] leading-[1.2] tracking-tight mb-3"
          style="font-family: var(--font-serif); font-weight: 400; color: var(--color-ink);"
        >
          AWS Certified Developer · Associate
        </h3>
        <div
          class="mt-auto pt-4.5 border-t text-[13px] leading-[1.6]"
          style="border-color: var(--color-rule); color: var(--color-ink-soft); padding-top: 18px;"
        >
          <span
            class="block mb-0.5 text-[10.5px] uppercase tracking-[0.12em]"
            style="font-family: var(--font-mono); color: var(--color-ink-faint);"
          >
            Issued by
          </span>
          Amazon Web Services<br />
          <span
            class="block mt-3.5 mb-0.5 text-[10.5px] uppercase tracking-[0.12em]"
            style="font-family: var(--font-mono); color: var(--color-ink-faint);"
          >
            Credential ID
          </span>
          P89BL4JKLBR11MSR
        </div>
      </article>

      <article
        class="p-8 rounded-[4px] border min-h-[280px] flex flex-col"
        style="background: var(--color-paper-card); border-color: var(--color-rule);"
      >
        <div
          class="mb-7 text-[11px] uppercase tracking-[0.14em]"
          style="font-family: var(--font-mono); color: var(--color-red);"
        >
          Languages
        </div>
        <h3
          class="text-[26px] leading-[1.2] tracking-tight mb-3"
          style="font-family: var(--font-serif); font-weight: 400; color: var(--color-ink);"
        >
          Spanish · English · German
        </h3>
        <div
          class="mt-auto pt-4.5 border-t flex flex-wrap gap-4"
          style="border-color: var(--color-rule); padding-top: 18px;"
        >
          {
            languages.map((l) => (
              <div class="flex flex-col flex-1 min-w-[80px]">
                <span class="text-[14px]" style="color: var(--color-ink);">
                  {l.name}
                </span>
                <div
                  class="h-[3px] rounded-[2px] overflow-hidden mt-2"
                  style="background: var(--color-rule);"
                >
                  <i class="block h-full" style={`width: ${l.pct}%; background: var(--color-red);`} />
                </div>
                <span
                  class="text-[10px] uppercase tracking-[0.1em] mt-1"
                  style="font-family: var(--font-mono); color: var(--color-ink-faint);"
                >
                  {l.level}
                </span>
              </div>
            ))
          }
        </div>
      </article>
    </div>
  </div>
</section>
