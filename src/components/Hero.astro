---
import { Icon } from "astro-icon/components";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div
    aria-hidden="true"
    class="absolute top-[10%] -left-[10%] w-[500px] h-[500px] rounded-full blur-[60px]"
    style="background: radial-gradient(circle, rgba(16,185,129,0.15) 0%, transparent 70%);"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute bottom-[10%] -right-[10%] w-[500px] h-[500px] rounded-full blur-[60px]"
    style="background: radial-gradient(circle, rgba(6,182,212,0.15) 0%, transparent 70%);"
  >
  </div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 pt-20 text-center animate-fade-in-slow">
    <h1
      class="font-display font-bold tracking-tight text-5xl md:text-7xl gradient-text mb-4 leading-tight"
    >
      Pablo Fallas Rodríguez
    </h1>
    <p class="text-2xl md:text-3xl text-ink-50 font-light mb-2">
      Infrastructure Engineering Manager
    </p>
    <p class="text-lg md:text-xl text-ink-400 mb-2">
      DevOps / Site Reliability Engineer
    </p>
    <p class="text-base text-ink-400 mb-10">Berlin, Germany</p>

    <div class="flex flex-wrap gap-4 justify-center mb-10">
      <a
        href="#contact"
        class="px-7 py-3 rounded-full font-semibold text-ink-900 bg-brand-gradient shadow-[0_8px_32px_rgba(16,185,129,0.3)] hover:scale-105 transition-transform"
      >
        Get in Touch
      </a>
      <a
        href="/CV_Pablo_Fallas.pdf"
        download
        class="inline-flex items-center gap-2 px-7 py-3 rounded-full font-semibold border border-brand-500 text-brand-400 hover:bg-brand-500/10 transition-colors"
      >
        <Icon name="mdi:download" class="w-5 h-5" />
        Download CV
      </a>
    </div>

    <div class="flex gap-3 justify-center">
      <a
        href="https://github.com/pfallasro"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="p-2.5 rounded-full text-brand-400 hover:bg-brand-500/10 transition-colors"
      >
        <Icon name="mdi:github" class="w-6 h-6" />
      </a>
      <a
        href="https://linkedin.com/in/pfallasro"
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        class="p-2.5 rounded-full text-brand-400 hover:bg-brand-500/10 transition-colors"
      >
        <Icon name="mdi:linkedin" class="w-6 h-6" />
      </a>
      <a
        href="mailto:pfallasro@gmail.com"
        aria-label="Email"
        class="p-2.5 rounded-full text-brand-400 hover:bg-brand-500/10 transition-colors"
      >
        <Icon name="mdi:email" class="w-6 h-6" />
      </a>
    </div>
  </div>

  <a
    href="#about"
    aria-label="Scroll to About"
    class="absolute bottom-10 left-1/2 -translate-x-1/2 p-2 text-brand-400 animate-bounce"
  >
    <Icon name="mdi:chevron-down" class="w-7 h-7" />
  </a>
</section>
