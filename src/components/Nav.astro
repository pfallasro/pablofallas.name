---
const links = [
  { href: "#about", label: "About" },
  { href: "#expertise", label: "Expertise" },
  { href: "#experience", label: "Experience" },
  { href: "#education", label: "Education" },
];
---

<header
  class="fixed top-[6px] inset-x-0 z-50 backdrop-blur-xl border-b"
  style="background: color-mix(in oklch, var(--color-paper) 78%, transparent); border-color: var(--color-rule);"
>
  <nav class="max-w-[1240px] mx-auto px-6 md:px-8 py-3 flex items-center justify-between gap-4">
    <a
      href="#hero"
      class="flex items-center gap-2.5 whitespace-nowrap text-[22px] italic tracking-tight"
      style="font-family: var(--font-serif);"
      aria-label="Pablo Fallas, home"
    >
      <span
        class="inline-block w-2 h-2 rounded-full"
        style="background: var(--color-red); box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-red) 18%, transparent);"
      ></span>
      Pablo Fallas
    </a>
    <ul class="hidden sm:flex items-center gap-1">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="px-3 py-2 text-[13px] font-medium rounded-full whitespace-nowrap transition-colors"
              style="color: var(--color-ink-soft);"
              onmouseover="this.style.color='var(--color-ink)'; this.style.background='color-mix(in oklch, var(--color-ink) 6%, transparent)'"
              onmouseout="this.style.color='var(--color-ink-soft)'; this.style.background='transparent'"
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="#contact"
          class="ml-2 px-4 py-[9px] text-[13px] font-semibold rounded-full whitespace-nowrap transition-colors"
          style="background: var(--color-ink); color: var(--color-paper);"
          onmouseover="this.style.background='var(--color-red)'; this.style.color='var(--color-ink)'"
          onmouseout="this.style.background='var(--color-ink)'; this.style.color='var(--color-paper)'"
        >
          Get in touch →
        </a>
      </li>
    </ul>
  </nav>
</header>
