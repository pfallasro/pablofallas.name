---
const links = [
  { href: "#about", label: "About" },
  { href: "#expertise", label: "Expertise" },
  { href: "#experience", label: "Experience" },
  { href: "#education", label: "Education" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 backdrop-blur-xl bg-ink-900/80 border-b border-white/5"
>
  <nav
    class="max-w-7xl mx-auto px-6 md:px-10 h-16 flex items-center justify-between"
  >
    <a
      href="#hero"
      class="text-lg font-bold gradient-text tracking-tight"
      aria-label="Pablo Fallas — home"
    >
      Pablo Fallas
    </a>
    <ul class="hidden sm:flex items-center gap-1">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="px-4 py-2 text-sm font-medium text-ink-50/90 rounded-full hover:bg-white/5 hover:text-brand-400 transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
