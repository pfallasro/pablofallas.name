---
const year = new Date().getFullYear();
---

<footer class="border-t py-10 pb-14" style="border-color: var(--color-rule);">
  <div class="max-w-[1240px] mx-auto px-6 md:px-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div
        class="text-[11.5px] uppercase tracking-[0.12em]"
        style="font-family: var(--font-mono); color: var(--color-ink-faint);"
      >
        © {year} Pablo Fallas Rodríguez
      </div>
      <div
        class="text-[11.5px] uppercase tracking-[0.12em]"
        style="font-family: var(--font-mono); color: var(--color-ink-faint);"
      >
        Made with <span style="color: var(--color-red);">♥</span> from Berlin
        <span
          class="ml-2 normal-case tracking-normal"
          style="font-family: var(--font-serif); font-style: italic; font-size: 16px; color: var(--color-red);"
        >
          · Pura vida
        </span>
      </div>
      <div
        class="text-[11.5px] uppercase tracking-[0.12em]"
        style="font-family: var(--font-mono); color: var(--color-ink-faint);"
      >
        v2 · costa rica edition
      </div>
    </div>
  </div>
</footer>
