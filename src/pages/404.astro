---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Page not found - Pablo Fallas Rodríguez"
  description="The page you were looking for doesn't exist or has moved."
>
  <Nav />
  <main
    id="main"
    class="min-h-[70vh] flex items-center justify-center pt-32 pb-24 px-6"
  >
    <div class="max-w-[560px] text-center">
      <p
        class="text-[11px] uppercase tracking-[0.14em] mb-6"
        style="font-family: var(--font-mono); color: var(--color-red);"
      >
        Error · 404
      </p>
      <h1
        class="serif-display text-[clamp(96px,16vw,200px)] mb-6"
        style="color: var(--color-ink);"
      >
        Lost in
        <em style="font-style: italic; color: var(--color-red);">transit</em>.
      </h1>
      <p
        class="text-[18px] leading-[1.6] mb-10"
        style="font-family: var(--font-serif); color: var(--color-ink-soft);"
      >
        The page you were looking for doesn't exist, or has been moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full text-sm font-semibold transition-colors"
        style="background: var(--color-ink); color: var(--color-paper);"
        onmouseover="this.style.background='var(--color-red)'; this.style.color='var(--color-ink)'"
        onmouseout="this.style.background='var(--color-ink)'; this.style.color='var(--color-paper)'"
      >
        Back to the home page
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </main>
  <Footer />
</Base>
