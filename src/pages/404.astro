---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page Not Found - Pablo Fallas Rodríguez"
  description="The page you're looking for doesn't exist."
>
  <main
    class="min-h-screen flex items-center justify-center px-6 text-center"
  >
    <div class="max-w-lg">
      <p class="text-7xl md:text-8xl font-display font-bold gradient-text mb-4">
        404
      </p>
      <h1 class="text-2xl md:text-3xl font-semibold text-ink-50 mb-3">
        Page not found
      </h1>
      <p class="text-ink-400 mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-block px-7 py-3 rounded-full font-semibold text-ink-900 bg-brand-gradient shadow-[0_8px_32px_rgba(16,185,129,0.3)] hover:scale-105 transition-transform"
      >
        Back home
      </a>
    </div>
  </main>
</Base>
